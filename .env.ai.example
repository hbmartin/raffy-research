# Split-brain evidence-mode local AI overrides.
# Copy to .env.ai.local after pulling production Vercel env into .env.local.

# Local app URL used by dev-only AI tools and console actions.
# Loaded through dotenv-cli, which expands ${VITE_PORT}; replace manually when
# using a loader without variable expansion.
VITE_BASE_URL="http://localhost:${VITE_PORT}"

# Evidence mode normally reads the same Neon DB as Vercel runtime.
DATABASE_DRIVER="neon-http"
# Label the executing process, even when .env.local contains production labels.
OTEL_ENVIRONMENT="local"
VITE_OTEL_ENVIRONMENT="local"
# Required before running pnpm db:migrate:evidence against Neon.
# DATABASE_MIGRATION_URL="postgres://..."
# DATABASE_MIGRATION_DRIVER="neon-websocket"

# Local AI defaults. Provider values: codex-cli, claude-code, or ollama.
LOCAL_AI_PROVIDER=codex-cli
LOCAL_AI_MODEL=gpt-5-codex
LOCAL_AI_RAW_OUTPUT_DIR=.local-ai-runs
LOCAL_AI_TIMEOUT_MS=600000

# Authenticated app user who owns this personal newsletter worker.
# LOCAL_AI_OPERATOR_USER_ID="app-user-id"
# NEWSLETTER_INVOCATION_SECONDS=800
# NEWSLETTER_HOSTED_TIMEOUT_MS=600000
# NEWSLETTER_LOCAL_WORK_SECONDS=900
# NEWSLETTER_WORKERS_PAUSED=true

# Ollama base URL (only used when LOCAL_AI_PROVIDER="ollama").
# Default: http://localhost:11434/api
# OLLAMA_BASE_URL="http://localhost:11434/api"

# Ollama context window in tokens (only used when LOCAL_AI_PROVIDER="ollama").
# Unset, Ollama sizes the window itself and shifts out the oldest tokens when a
# prompt overflows it, which silently drops evidence from the head of the prompt.
# Set it to the model's context length to make an overflow fail loudly instead.
# qwen3:14b tops out at 40960. Report prompts run ~3.5 chars/token.
# OLLAMA_NUM_CTX=40960

# Arize Phoenix (cloud) — LLM tracing + eval experiments.
# PHOENIX_COLLECTOR_URL is the Phoenix base URL; the signal path is appended,
# so https://app.phoenix.arize.com/s/<space> becomes .../v1/traces.
# A value already ending in /v1 or /v1/traces is accepted and normalised.
# PHOENIX_APP_URL is the same space base URL for datasets/experiments:
# https://app.phoenix.arize.com/s/<space> (keep the /s/<space> prefix).
# PHOENIX_API_KEY is your Phoenix API key; keep it in ignored env files.
# PHOENIX_PROJECT_NAME pins every span to one Phoenix project. Leave it unset:
# the name is then derived as <service>-<environment> for the app and
# <service>-evals for the eval CLI, so production traffic, local runs and eval
# experiments land in separate projects instead of all in `default`.
# To reuse existing projects independently of OTEL_SERVICE_NAME, set both:
# PHOENIX_PROJECT_NAME="start-ui-web-local"
# PHOENIX_EVAL_PROJECT_NAME="start-ui-web-evals"
# The eval override wins for the CLI's model spans and SDK experiment spans.
# PHOENIX_COLLECTOR_URL=
# PHOENIX_APP_URL=
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=
# PHOENIX_EVAL_PROJECT_NAME=
